# Supabase (optional — leave empty for in-memory mode)
SUPABASE_URL=
SUPABASE_KEY=

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Admin login (set ADMIN_PASSWORD privately in your backend host settings)
ADMIN_EMAIL=admin@thecodevibe.io
ADMIN_PASSWORD=CODEVIBES2007

# IMPORTANT: put your Netlify URL here after frontend is live
# Example: https://code-vibe.netlify.app
# Or use * for first deploy, then lock it down
CORS_ORIGINS=*

# ===== EMAIL (required for form → inbox) =====
NOTIFY_EMAIL=thecodevibehack@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=thecodevibehack@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=The Code Vibe <thecodevibehack@gmail.com>
